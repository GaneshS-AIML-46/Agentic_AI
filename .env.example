# --- LLM ---
# gemini | openai | ollama | mock
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Embeddings ---
# gemini | mock
EMBEDDING_PROVIDER=mock
EMBEDDING_DIM=768

# --- Database ---
POSTGRES_USER=supplychain
POSTGRES_PASSWORD=supplychain
POSTGRES_DB=supplychain
POSTGRES_HOST=localhost
# Use 5433 when a local Windows Postgres already owns 5432
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg2://supplychain:supplychain@localhost:5433/supplychain

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# --- Solver ---
SOLVER_BACKEND=ortools
RISK_PENALTY_WEIGHT=1.25
MAX_REPLAN=2
